<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  
  <ItemGroup>
  <FrameworkReference Include="Microsoft.AspNetCore.App" />
</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.66.0" />
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.66.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Compiled here as "Both": this is the ONLY place metadata.proto and rbac.proto
    are compiled.
    - Consuming services (client side) reference this project and use
      MetaDataGrpcServiceClient / RbacServiceClient.
    - MetaDataService.API / IdentityService.API (server side) also reference this
      project and inherit MetaDataGrpcServiceBase / RbacServiceBase from here —
      they do NOT compile either .proto themselves.
    Compiling the same proto a second time in another project (even with GrpcServices="Server")
    regenerates the message classes there too, which then collide (CS0433) with the copies
    already sitting in this assembly. One compile, many consumers.
  -->
  <ItemGroup>
    <Protobuf Include="Protos/MetaDataService/metadata.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/IdentityService/rbac.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/IdentityService/employee_lookup.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/NotificationService/notification.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/ProgramService/program.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared.Common\Shared.Common.csproj" />
  </ItemGroup>

</Project>
